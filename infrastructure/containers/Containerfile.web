# ==========================================
# Stage 1: Dependencies & Build
# ==========================================
FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app
RUN apk add --no-cache libc6-compat

# Copy dependency definitions
COPY package.json pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/curriculum/package.json ./packages/curriculum/
COPY packages/lab-sdk/package.json ./packages/lab-sdk/

# Install pnpm & dependencies
RUN npm install -g pnpm@9.12.0
RUN pnpm install --frozen-lockfile=false

# Copy source code
COPY apps/web ./apps/web
COPY packages/shared-types ./packages/shared-types
COPY packages/ui ./packages/ui
COPY packages/curriculum ./packages/curriculum
COPY packages/lab-sdk ./packages/lab-sdk

# Build Next.js app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @kubelab/web build

# ==========================================
# Stage 2: Production Runner
# ==========================================
FROM docker.io/library/node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy build artifacts
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["node", "apps/web/server.js"]
