      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "API Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(kubelab_http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}} ({{status}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "API Request Duration (p99 Latency)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(kubelab_http_request_duration_seconds_bucket[1m]))",
          "legendFormat": "p99 {{path}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
